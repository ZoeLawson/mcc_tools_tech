<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="class_demo">
    <title>Class Demo</title>
    <shortdesc>Pretend this is a good short description.</shortdesc>
    <conbody>
        <p>This is a paragraph.</p>
        <ul>
            <li>List <term>Item</term> 1</li>
            <li>List Item 2<p>This is a <varname>paragraph</varname> nested
                        <uicontrol>under</uicontrol> the <xmlelement>li</xmlelement>.</p></li>
            <li>List item 3</li>
        </ul>
        <fig>
            <title>This is a figure caption</title>
            <image placement="break"
                href="../../../../../github_mcc-demo/GitHubDesktop/mcc_tools_tech/Week11-DITA/Homework/images/mcc_logo.jpg">
                <alt>Old Middlesex Community College Logo</alt>
            </image>
        </fig>
        <simpletable frame="all" relcolwidth="1* 3*">
            <sthead>
                <stentry/>
                <stentry/>
            </sthead>
            <strow>
                <stentry/>
                <stentry/>
            </strow>
            <strow>
                <stentry/>
                <stentry/>
            </strow>
            <strow>
                <stentry/>
                <stentry/>
            </strow>
        </simpletable>
        <table frame="all" rowsep="1" colsep="0">
            <title>Table Title</title>
            <desc>This is the table description for accessibility.</desc>
            <tgroup cols="2">
                <colspec colnum="1" colname="c1" colwidth="3*"/>
                <colspec colnum="2" colname="c2" colwidth="1*"/>
                <thead>
                    <row>
                        <entry>Column head</entry>
                        <entry/>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry/>
                        <entry/>
                    </row>
                    <row>
                        <entry/>
                        <entry/>
                    </row>
                    <row>
                        <entry/>
                        <entry/>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </conbody>
</concept>
